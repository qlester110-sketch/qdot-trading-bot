# =============================================================================
# Trading Bot Environment Template
# =============================================================================
# LOCAL MODE: Copy this file to `.env` and fill in real values.
# CLOUD MODE: Set these as environment variables on the routine itself.
#             DO NOT create or commit a .env in the cloud.
# =============================================================================

# -- Alpaca (PAPER trading only) ----------------------------------------------
# Get keys at: https://app.alpaca.markets/paper/dashboard/overview
# Generate via: API Keys -> Generate New Keys
# IMPORTANT: ALPACA_ENDPOINT must point at the paper-trading host.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# -- Slack (notifications) ----------------------------------------------------
# Two ways to send to Slack:
#
# 1) Incoming Webhook (simplest — recommended)
#    https://api.slack.com/messaging/webhooks
#    Create an app, enable Incoming Webhooks, add to a channel, paste URL here.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXX/BXXXXXX/your_token
#
# 2) Bot token (only fill if you want to use a bot token instead of webhook)
#    Leave SLACK_BOT_TOKEN unset to use the webhook above.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#trading-bot
